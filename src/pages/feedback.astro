---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeedbackStep from '../components/FeedbackStep.astro';

import { whatsappHref, INSTAGRAM_HREF } from '../consts';
---

<BaseLayout>
    <div id="intro-section">
        <Hero
        heroBgImgSrc = "/images/feedback/feedback-hero.png"
        sources = {[{ media: "(max-width: 768px)", srcset: "/images/feedback/feedback-hero.png" }]}
        heroClass = "hero--feedback"
        showArrow = {false}
    >
        <div id="step-intro" class="hero__top">
            <div class="feedback__logo">
                <div class="feedback__container-logo">
                    <img src="/images/shared/simbolo-logo.png" class="feedback__logo-icon" alt="Logo da Infotell" />
                    <div class="feedback__logo-text">
                        <span class="feedback__logo-name">Infotell</span>
                    </div>
                </div>
                <p class="feedback__logo-sub">SEGURANÇA ELETRÔNICA &#8226; TECNOLOGIA</p>
            </div>

            <h1 class="hero__title a">
                <span class="hero__title--highlight">
                    Agradecemos sua parceria
                </span>
            </h1>

            <p class="hero__description feedback_hero-description">
            Queremos saber como foi sua experiência e garantir que continuemos entregando o melhor serviço para você.
            </p>
            <div class="feedback_hero-description-sub">
                <i class="fa-regular fa-clock"></i>
                <span>Leva menos de 2 minutos</span>
            </div>
            <button type="button" class="feedback__button" id="btn-start-evaluation">
                COMEÇAR AVALIAÇÃO
            </button>

            <div class="feedback__security">
                <i class="fa-solid fa-lock"></i>
                <span>Seus dados estão seguros conosco.</span>
            </div>
        </div>
	</Hero>
    </div>

    <main id="form-section" class="feedback-page-wrapper" style="display: none;">
        <form id="feedback-form" class="feedback-form">
            
        <FeedbackStep 
            id="step-1"
            step={1} 
            title="Olá! Vamos começar."
            subtitle="Como podemos chamar você?"
            showBack={false}
        >
            <div class="field feedback-step__input-group">
                <label for="userName" class="sr-only">Nome</label>
                <div class="input-wrapper">
                    <input type="text" id="userName" name="fi-sender-fullName" placeholder="Digite seu nome" required />
                    <i class="fa-regular fa-user input-icon"></i>
                </div>
            </div>
        </FeedbackStep>

        <FeedbackStep 
            id="step-2"
            step={2} 
            title="Quais dos serviços foram contratados?"
            subtitle="Selecione abaixo."
        >
            <div class="services-grid">
                <label class="service-card">
                    <input type="checkbox" name="fi-text-services" value="cameras" class="sr-only" />
                    <div class="service-card__content">
                        <i class="fa-solid fa-video service-card__icon"></i>
                        <span class="service-card__label">Câmeras de segurança</span>
                    </div>
                </label>
                <label class="service-card">
                    <input type="checkbox" name="fi-text-services" value="alarmes" class="sr-only" />
                    <div class="service-card__content">
                        <i class="fa-regular fa-bell service-card__icon"></i>
                        <span class="service-card__label">Alarmes</span>
                    </div>
                </label>
                <label class="service-card">
                    <input type="checkbox" name="fi-text-services" value="controle-acesso" class="sr-only" />
                    <div class="service-card__content">
                        <i class="fa-solid fa-id-card service-card__icon"></i>
                        <span class="service-card__label">Controle de acesso</span>
                    </div>
                </label>
                <label class="service-card">
                    <input type="checkbox" name="fi-text-services" value="automacao" class="sr-only" />
                    <div class="service-card__content">
                        <i class="fa-solid fa-house-laptop service-card__icon"></i>
                        <span class="service-card__label">Automação</span>
                    </div>
                </label>
                <label class="service-card">
                    <input type="checkbox" name="fi-text-services" value="portao-eletronico" class="sr-only" />
                    <div class="service-card__content">
                        <i class="fa-solid fa-door-open service-card__icon"></i>
                        <span class="service-card__label">Portão eletrônico</span>
                    </div>
                </label>
                <label class="service-card">
                    <input type="checkbox" name="fi-text-services" value="eletrica" class="sr-only" />
                    <div class="service-card__content">
                        <i class="fa-solid fa-bolt service-card__icon"></i>
                        <span class="service-card__label">Elétrica</span>
                    </div>
                </label>
                <label class="service-card">
                    <input type="checkbox" name="fi-text-services" value="outro" id="checkbox-outro" class="sr-only" />
                    <div class="service-card__content">
                        <i class="fa-solid fa-ellipsis service-card__icon"></i>
                        <span class="service-card__label">Outro serviço</span>
                    </div>
                </label>
            </div>

            <div id="other-service-container" class="field feedback-step__input-group" style="display: none; margin-top: 1.5rem;">
                <label for="otherService" class="sr-only">Qual outro serviço?</label>
                <div class="input-wrapper">
                    <input type="text" id="otherService" name="fi-text-other_service" placeholder="Qual outro serviço?" />
                    <i class="fa-solid fa-pen input-icon"></i>
                </div>
            </div>
        </FeedbackStep>

        <FeedbackStep 
            id="step-3"
            step={3} 
            title="De 0 a 10, quanto você ficou satisfeito com a Infotell?"
            subtitle="Sua satisfação é muito importante para nós."
        >
            <div class="satisfaction-rating">
                <div class="satisfaction-rating__emoji-bar">
                    <i class="fa-regular fa-face-frown rating-emoji rating-emoji--sad"></i>
                    <div class="rating-line-indicator"></div>
                    <i class="fa-regular fa-face-smile-wink rating-emoji rating-emoji--happy"></i>
                </div>
                
                <div class="rating-buttons">
                    {Array.from({ length: 11 }).map((_, i) => (
                        <label class="rating-btn">
                            <input type="radio" name="fi-text-satisfaction" value={i} class="sr-only" required />
                            <span class="rating-btn__label">{i}</span>
                        </label>
                    ))}
                </div>
                
                <div class="satisfaction-feedback" id="satisfaction-feedback-box" style="display: none;">
                    <i class="fa-solid fa-star satisfaction-feedback__icon"></i>
                    <div class="satisfaction-feedback__text">
                        <strong class="satisfaction-feedback__title">Excelente!</strong>
                        <span class="satisfaction-feedback__desc">Ficamos muito felizes em saber disso.</span>
                    </div>
                </div>
            </div>
        </FeedbackStep>

        <FeedbackStep 
            id="step-4-1"
            step={4} 
            title="Como foi sua experiência com nossa equipe?"
            subtitle="Avalie o atendimento e o serviço prestado."
        >
            <div class="team-rating-grid">
                <label class="team-rating-card">
                    <input type="radio" name="fi-text-team_rating" value="excelente" class="sr-only" required />
                    <div class="team-rating-card__content">
                        <i class="fa-regular fa-face-grin-stars team-rating-card__icon team-rating-card__icon--excelente"></i>
                        <span class="team-rating-card__label">Excelente</span>
                    </div>
                </label>
                <label class="team-rating-card">
                    <input type="radio" name="fi-text-team_rating" value="bom" class="sr-only" />
                    <div class="team-rating-card__content">
                        <i class="fa-regular fa-face-smile team-rating-card__icon team-rating-card__icon--bom"></i>
                        <span class="team-rating-card__label">Muito bom</span>
                    </div>
                </label>
                <label class="team-rating-card">
                    <input type="radio" name="fi-text-team_rating" value="regular" class="sr-only" />
                    <div class="team-rating-card__content">
                        <i class="fa-regular fa-face-meh team-rating-card__icon team-rating-card__icon--regular"></i>
                        <span class="team-rating-card__label">Regular</span>
                    </div>
                </label>
                <label class="team-rating-card">
                    <input type="radio" name="fi-text-team_rating" value="melhorar" class="sr-only" />
                    <div class="team-rating-card__content">
                        <i class="fa-regular fa-face-frown team-rating-card__icon team-rating-card__icon--ruim"></i>
                        <span class="team-rating-card__label">Precisa melhorar</span>
                    </div>
                </label>
            </div>
        </FeedbackStep>

        <FeedbackStep 
            id="step-4-2"
            step={4} 
            title="O técnico explicou corretamente o funcionamento do equipamento?"
        >
            <div class="radio-group-vertical">
                <label class="radio-option">
                    <input type="radio" name="fi-text-technician_explanation" value="sim" class="sr-only" required />
                    <div class="radio-option__ui"></div>
                    <span class="radio-option__label">Sim, explicou tudo</span>
                </label>
                <label class="radio-option">
                    <input type="radio" name="fi-text-technician_explanation" value="orientacao" class="sr-only" />
                    <div class="radio-option__ui"></div>
                    <span class="radio-option__label">Preciso de mais orientação</span>
                </label>
                <label class="radio-option">
                    <input type="radio" name="fi-text-technician_explanation" value="nao" class="sr-only" />
                    <div class="radio-option__ui"></div>
                    <span class="radio-option__label">Não consegui acompanhar</span>
                </label>
            </div>
        </FeedbackStep>

        <FeedbackStep 
            id="step-5"
            step={5} 
            title="Quer continuar conectado com a Infotell?"
            subtitle="Escolha as opções abaixo:"
        >
            <div class="relationship-grid">
                <div class="relationship-card">
                    <div class="relationship-card__header">
                        <i class="fa-regular fa-envelope relationship-card__icon"></i>
                        <div class="relationship-card__header-text">
                            <h3 class="relationship-card__title">Receber novidades</h3>
                            <p class="relationship-card__desc">Receba dicas de segurança, promoções e novidades.</p>
                        </div>
                    </div>
                    <div class="radio-group-vertical radio-group-vertical--small">
                        <label class="radio-option">
                            <input type="radio" name="fi-text-receive_news" value="sim" class="sr-only" required />
                            <div class="radio-option__ui"></div>
                            <span class="radio-option__label">Sim, quero receber</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="fi-text-receive_news" value="depois" class="sr-only" />
                            <div class="radio-option__ui"></div>
                            <span class="radio-option__label">Talvez mais tarde</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="fi-text-receive_news" value="nao" class="sr-only" />
                            <div class="radio-option__ui"></div>
                            <span class="radio-option__label">Não tenho interesse</span>
                        </label>
                    </div>
                    
                    <div id="email-container" class="field feedback-step__input-group" style="display: none; margin-top: 1rem;">
                        <label for="newsEmail" class="sr-only">E-mail</label>
                        <div class="input-wrapper">
                            <input type="email" id="newsEmail" name="fi-sender-email" placeholder="Digite seu e-mail" />
                            <i class="fa-regular fa-envelope input-icon"></i>
                        </div>
                    </div>
                </div>

                <div class="relationship-card">
                    <div class="relationship-card__header">
                        <i class="fa-regular fa-star relationship-card__icon"></i>
                        <div class="relationship-card__header-text">
                            <h3 class="relationship-card__title">Compartilhar avaliação</h3>
                            <p class="relationship-card__desc">Podemos publicar sua avaliação em nossos canais?</p>
                        </div>
                    </div>
                    <div class="radio-group-vertical radio-group-vertical--small">
                        <label class="radio-option">
                            <input type="radio" name="fi-text-share_evaluation" value="autorizo" class="sr-only" required />
                            <div class="radio-option__ui"></div>
                            <span class="radio-option__label">Autorizo</span>
                        </label>
                        <label class="radio-option">
                            <input type="radio" name="fi-text-share_evaluation" value="nao_autorizo" class="sr-only" />
                            <div class="radio-option__ui"></div>
                            <span class="radio-option__label">Não autorizo</span>
                        </label>
                    </div>
                </div>
            </div>
        </FeedbackStep>

        <FeedbackStep 
            id="step-comments"
            title="Sua opinião faz a diferença."
            subtitle="Existe algo que podemos melhorar ou algo que você gostaria de destacar?"
            hideProgress={true}
            nextButtonText="ENVIAR AVALIAÇÃO"
        >
            <div class="feedback-textarea-wrapper">
                <textarea 
                    id="feedback-comments" 
                    name="fi-text-comments" 
                    rows="6" 
                    maxlength="500" 
                    placeholder="Conte como foi sua experiência com a Infotell..."
                ></textarea>
                <div class="char-counter"><span id="char-count">0</span>/500</div>
            </div>
            <p id="form-status" class="form-status-msg" aria-live="polite" style="display:none;"></p>
        </FeedbackStep>

    </form>
    </main>

    <div id="thanks-section" style="display: none;">
        <Hero
            showArrow = {false}
        >
            <div id="step-thanks" class="feedback-thanks">
        <div class="feedback-thanks__header">
            <div class="feedback-thanks__icon-wrapper">
                <i class="fa-solid fa-check"></i>
            </div>
            <h1 class="feedback-thanks__title">Obrigado, <span id="thanks-name"></span>!</h1>
            <p class="feedback-thanks__subtitle">
                Sua avaliação foi enviada com sucesso.<br>
                Continuaremos trabalhando para proteger o que é importante para você.
            </p>
        </div>

        <div class="feedback-thanks__sections">
            
            <div class="thanks-section">
                <h3 class="thanks-section__title">O que acontece agora?</h3>
                <ul class="thanks-list">
                    <li>
                        <i class="fa-solid fa-shield-halved"></i>
                        <span>Sua avaliação ajuda nossa equipe a melhorar cada vez mais.</span>
                    </li>
                    <li>
                        <i class="fa-regular fa-comments"></i>
                        <span>Agradecemos seu apoio e participação.</span>
                    </li>
                    <!-- <li>
                        <i class="fa-solid fa-headset"></i>
                        <span>Em breve podemos entrar em contato para manter tudo funcionando perfeitamente.</span>
                    </li> -->
                </ul>
            </div>

            <div class="thanks-section">
                <h3 class="thanks-section__title">Acompanhe a Infotell</h3>
                <p class="thanks-section__desc">Siga nossas redes sociais e fique por dentro de novidades e dicas de segurança.</p>
                <div class="thanks-social">
                    <a href={INSTAGRAM_HREF} target="_blank" rel="noopener noreferrer" class="thanks-social__link" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href={whatsappHref('Olá! Estou acessando o site e gostaria de...')} target="_blank" rel="noopener noreferrer" class="thanks-social__link" aria-label="WhatsApp"><i class="fa-brands fa-whatsapp"></i></a>
                </div>
                <div class="thanks-actions">
                    <a href="/" class="btn-step btn-step--outline">
                        <i class="fa-solid fa-house"></i> VISITE NOSSO SITE
                    </a>
                    <a href={whatsappHref('Olá! Estou acessando o site e gostaria de...')} target="_blank" rel="noopener noreferrer" class="btn-step btn-step--next">
                        <i class="fa-brands fa-whatsapp"></i> FALAR NO WHATSAPP
                    </a>
                </div>
            </div>

            <div class="thanks-section">
                <h3 class="thanks-section__title">Por que sua opinião importa?</h3>
                <div class="thanks-reasons-grid">
                    <div class="thanks-reason">
                        <i class="fa-solid fa-medal"></i>
                        <div class="thanks-reason__text">
                            <strong>Atendimento de excelência</strong>
                            <span>Buscamos sempre superar expectativas.</span>
                        </div>
                    </div>
                    <div class="thanks-reason">
                        <i class="fa-solid fa-microchip"></i>
                        <div class="thanks-reason__text">
                            <strong>Tecnologia que protege</strong>
                            <span>Soluções modernas para sua segurança.</span>
                        </div>
                    </div>
                    <div class="thanks-reason">
                        <i class="fa-solid fa-arrow-trend-up"></i>
                        <div class="thanks-reason__text">
                            <strong>Melhoria contínua</strong>
                            <span>Seu feedback nos ajuda a evoluir sempre.</span>
                        </div>
                    </div>
                    <div class="thanks-reason">
                        <i class="fa-solid fa-handshake-simple"></i>
                        <div class="thanks-reason__text">
                            <strong>Confiança que constrói</strong>
                            <span>Relacionamentos duradouros são nossa prioridade.</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="feedback-thanks__footer">
            <div class="ft-footer__left">
                <span class="ft-footer__brand">Infotell</span>
                <span class="ft-footer__tag">SEGURANÇA ELETRÔNICA &#8226; TECNOLOGIA</span>
            </div>
            <div class="ft-footer__center">
                Infotell Segurança e Tecnologia LTDA. Todos os direitos reservados.
            </div>
            <div class="ft-footer__right hero__intelbras">
                <span class="hero__intelbras-label">Revenda autorizada</span>
                <span class="hero__intelbras-brand">intelbras</span>
            </div>
        </div>
        </div>
    </Hero>
    </div>
    <script src="../scripts/pages/feedback.js"></script>
</BaseLayout>