---
// src/components/Footer.astro
// Footer de diferenciais + rodapé completo (logo, redes sociais, copyright)
// O bloco de diferenciais é ocultado no mobile via CSS.

import { whatsappHref, INSTAGRAM_HREF, EMAIL_CONTATO } from '../consts';

const diferenciais = [
	{ id: 'atendimento', icon: 'fa-headset', texto: 'Atendimento rápido e personalizado' },
	{ id: 'equipamentos', icon: 'fa-award', texto: 'Equipamentos de qualidade' },
	{ id: 'instalacao', icon: 'fa-screwdriver-wrench', texto: 'Instalação profissional e segura' },
	{ id: 'suporte', icon: 'fa-life-ring', texto: 'Suporte técnico especializado' },
	{ id: 'solucoes', icon: 'fa-users', texto: 'Soluções para todos os perfis' },
];
---

<!-- Diferenciais — visíveis apenas no desktop -->
<div class="diferenciais" aria-label="Diferenciais da Infotell">
	<div class="diferenciais__container">
		{diferenciais.map((d) => (
			<div class="diferencial" id={`diferencial-${d.id}`}>
				<div class="diferencial__icon" aria-hidden="true">
					<i class={`fa-solid ${d.icon}`}></i>
				</div>
				<span class="diferencial__texto">{d.texto}</span>
			</div>
		))}
	</div>
</div>

<!-- Rodapé inferior — visível em todas as versões -->
<footer class="footer-base" aria-label="Rodapé Infotell">
	<div class="footer-base__container">
		<a href="/#inicio" class="footer-base__logo" aria-label="Infotell — Início">
			<img src="/images/shared/simbolo-logo.png" alt="Símbolo Infotell" class="footer-base__logo-icon" />
			<div class="footer-base__logo-text">
				<span class="footer-base__logo-name">Infotell</span>
				<span class="footer-base__logo-sub">SEGURANÇA E TECNOLOGIA PARA VOCÊ DESDE 2013.</span>
			</div>
		</a>

		<nav class="footer-base__social" aria-label="Redes sociais">
			<a href={INSTAGRAM_HREF} class="footer-base__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
				<i class="fa-brands fa-instagram"></i>
			</a>
			<a href="https://www.facebook.com" class="footer-base__social-link" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
				<i class="fa-brands fa-facebook-f"></i>
			</a>
			<a href={whatsappHref("Olá, gostaria de um atendimento!")} class="footer-base__social-link" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
				<i class="fa-brands fa-whatsapp"></i>
			</a>
			<a href={`mailto:${EMAIL_CONTATO}`} class="footer-base__social-link" aria-label="E-mail">
				<i class="fa-solid fa-envelope"></i>
			</a>
		</nav>

		<p class="footer-base__copy">© {new Date().getFullYear()} Infotell. Todos os direitos reservados.</p>
	</div>
</footer>
